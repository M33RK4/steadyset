<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ always shows its own launch screen. It's kept plain, in the same colour, so the
         logo only appears once, in the app's own animation. -->
    <style name="AppTheme" parent="Base">
        <item name="android:windowSplashScreenBackground">@color/splash</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/empty</item>
    </style>
</resources>
