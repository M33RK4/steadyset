# Supabase project settings → API (or "Connect" → App Frameworks → Next.js).
# Both values are public and safe in the browser. NEVER put the service_role / secret key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Use either the newer publishable key or the legacy anon key:
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
